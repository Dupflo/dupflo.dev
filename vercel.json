{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/liste{/}?",
      "destination": "/fr/liste-attente/",
      "permanent": false
    },
    {
      "source": "/mentions-legales{/}?",
      "destination": "/fr/mentions-legales",
      "permanent": true
    },
    {
      "source": "/confidentialite{/}?",
      "destination": "/fr/confidentialite",
      "permanent": true
    },
    {
      "source": "/kit{/}?",
      "destination": "/kit-survie-numerique.pdf",
      "permanent": false
    },
    {
      "source": "/opencode{/}?",
      "destination": "/guide-opencode.pdf",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/kit-survie-numerique.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"kit-survie-numerique-dupflodev.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/guide-opencode.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"guide-opencode-dupflodev.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ]
}
