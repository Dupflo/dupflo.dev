# Instagram Graph API — used by the sync scripts only, never at build time.
# .env is gitignored. On Vercel none of this is needed: the sync writes files
# that you commit.

# Values also load from .env.local, which is what `vercel env pull` writes.
# App dashboard → Settings → Basic
IG_APP_ID=28458692813733772
IG_APP_SECRET=

# Paste a fresh short-lived token from the Graph API Explorer here, then run
# `npm run token:refresh`. It swaps both values below for a permanent Page
# token and the right Instagram account id.
IG_ACCESS_TOKEN=
IG_USER_ID=
