---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { DESCRIPTION } from '../consts';
---

<Base lang="en" description={DESCRIPTION.en} translationHref="/fr/">
  <Fragment slot="head">
    <!-- The masthead is the LCP element and the only serif above the fold. -->
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>
  <Home lang="en" />
</Base>
