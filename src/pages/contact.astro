---
/**
 * Contact, English. One real mailto link, a stated response time, and the
 * entity behind the address — which is what a platform reviewer looks for.
 *
 * No form: a form means a backend, a spam filter and a consent notice for
 * something an email link already does.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import EntityCard from '../components/EntityCard.astro';
import { business } from '../config/business';
import { identityPath, identityTwin } from '../i18n/pages';

const lang = 'en' as const;
const twin = identityTwin('contact', lang);

const title = 'Contact';
const description = `Write to ${business.legalName}: ${business.email}. Reply within two working days. ${business.legalForm.en}, SIRET ${business.siret}.`;
---

<Base lang={lang} title={title} description={description} translationHref={twin}>
  <PageHeader
    title={title}
    intro="One address, a real person at the other end, and a reply within two working days."
  />

  <section class="border-b py-8">
    <p class="text-[11px] uppercase tracking-[0.18em] text-dim">Email</p>
    <p class="font-display mt-2 text-4xl leading-none tracking-tight break-all">
      <a
        href={`mailto:${business.email}`}
        class="text-accent underline decoration-1 underline-offset-[6px]"
      >
        {business.email}
      </a>
    </p>
    <p class="font-text mt-4 max-w-[70ch] text-[17px] leading-[1.5] text-dim">
      This is the site's only contact address, and I read it myself. Reply within
      <strong class="text-ink">two working days</strong>. Past that, assume the
      message got lost and send it again — it happens.
    </p>
  </section>

  <div class="prose mt-8">
    <h2>What people write about</h2>
    <ul>
      <li>
        <strong>Work and engagements</strong>: application development, tooling
        for AI agents, MCP integrations. Give me the context, the scope and the
        deadline — I need them to answer with anything other than a question.
      </li>
      <li>
        <strong>Feedback on an article or a video</strong>: a correction, a
        reasoned disagreement, a blind spot. That is the mail I read first.
      </li>
      <li>
        <strong>Open-source projects</strong>: for a bug or a feature, prefer an
        issue on the repository — the discussion stays public and useful to
        everyone else.
      </li>
      <li>
        <strong>Personal data</strong>: access, rectification, erasure. See the
        {' '}<a href={identityPath('privacy', lang)}>privacy policy</a>.
      </li>
    </ul>

    <h2>Post and phone</h2>
    <p>
      The registered office address and the phone number are in the block below,
      and in the
      {' '}<a href={identityPath('legal', lang)}>legal notice</a>. Email is the
      fastest channel.
    </p>
  </div>

  <SectionHeader label="Entity" />
  <EntityCard lang={lang} variant="compact" />

  <p class="mt-4 text-[12px] text-dim">{business.vat.en}</p>
  <p class="mt-2 text-[12px] text-dim">
    Full details, host and terms:
    {' '}<a
      href={identityPath('legal', lang)}
      class="hover:text-accent underline decoration-1 underline-offset-[3px]"
    >
      legal notice
    </a>.
  </p>
</Base>
