---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { Image } from 'astro:assets';
import { compact, iso, ROW, ROW_WIDE, ROW_GROUP } from '../../lib/entry';

/**
 * A series index, deliberately absent from the navigation: it is reached from a
 * video comment or a bio link, not by browsing.
 */
export async function getStaticPaths() {
  const videos = await getCollection('videos', ({ data }) => Boolean(data.series));
  const bySeries = new Map<string, CollectionEntry<'videos'>[]>();
  for (const video of videos) {
    const key = video.data.series!;
    bySeries.set(key, [...(bySeries.get(key) ?? []), video]);
  }
  return [...bySeries].map(([series, episodes]) => ({
    params: { series },
    props: {
      series,
      episodes: episodes.sort(
        (a: CollectionEntry<'videos'>, b: CollectionEntry<'videos'>) =>
          (a.data.episode ?? 0) - (b.data.episode ?? 0),
      ),
    },
  }));
}

const lang = 'fr' as const;
const { series, episodes } = Astro.props as {
  series: string;
  episodes: CollectionEntry<'videos'>[];
};
const title = series === '1jour1skill' ? 'Un jour, un skill' : series;
---

<Base lang={lang} title={title}>
  <PageHeader
    title={title}
    intro="La série où je teste un outil IA pour de vrai à chaque épisode : installé, décortiqué, mis à l’épreuve."
    count={episodes.length}
  />

  <div class={ROW_GROUP}>
    {
      episodes.map((video) => (
        <a
          href={video.data.url}
          target="_blank"
          rel="noopener"
          class:list={[ROW, ROW_WIDE, 'py-4']}
        >
          <div class="flex items-baseline gap-3 text-[13px] tabular-nums text-dim">
            <span class="text-accent">
              {String(video.data.episode).padStart(2, '0')}
            </span>
            <time datetime={iso(video.data.date)}>{iso(video.data.date)}</time>
          </div>

          <div class="flex min-w-0 gap-4">
            {video.data.thumbnail && (
              <Image
                src={video.data.thumbnail}
                alt=""
                widths={[96, 192]}
                sizes="64px"
                loading="lazy"
                class="hidden h-24 w-16 shrink-0 border object-cover sm:block"
              />
            )}

            <div class="min-w-0">
              <h2 class="text-[15px] font-semibold group-hover:text-accent">
                {video.data.tool}
              </h2>
              <p class="font-text mt-1 text-[16px] leading-[1.45] text-dim">
                {video.data.pitch}
              </p>
              <p class="mt-2 flex gap-3 text-[12px] tabular-nums text-dim">
                {video.data.views !== undefined && (
                  <span>{compact(video.data.views)} vues</span>
                )}
                {video.data.likes !== undefined && (
                  <span>{compact(video.data.likes)} j’aime</span>
                )}
              </p>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Base>
