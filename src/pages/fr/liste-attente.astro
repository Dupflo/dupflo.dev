---
/**
 * Liste d'attente de la formation 101. Page autonome, volontairement hors du
 * gabarit du site : elle reprend l'univers des vidéos motion de @dupflodev
 * (fond sable, page blanche, sarcelle, bouton orange) pour qu'on passe d'une
 * vidéo à l'inscription sans changer de monde.
 *
 * L'inscription passe par /api/subscribe (Brevo), avec la source
 * `liste-attente-101`. Sans Brevo configuré, l'API répond 503 et la page le dit.
 */
const title = 'Liste d’attente · La formation — @dupflodev';
const description =
  'Je prépare ma formation : construire ton site professionnel avec l’IA. Inscris-toi pour être prévenu en premier et avoir accès au meilleur prix dès le lancement.';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Liste d’attente · Ton site pro, construit avec l’IA" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://dupflo.dev/fr/liste-attente/" />
    <link rel="canonical" href="https://dupflo.dev/fr/liste-attente/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      @font-face { font-family: "Outfit"; src: url("/fonts/Outfit.ttf") format("truetype"); font-weight: 100 900; font-display: swap; }
      :root {
        --sand: #f2e6da; --ink: #141414; --sec: #3d3a36; --muted: #7a736b;
        --teal: #2C6A6E; --teal-bg: #eaf3f2; --red: #D4452B; --orange: #F4AE5E; --line: #ebe3d9;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { min-height: 100%; background: #ecdccc; }
      body { min-height: 100vh; }
      body {
        font-family: "Inter", system-ui, sans-serif; color: var(--ink); -webkit-font-smoothing: antialiased;
        background: radial-gradient(1200px 900px at 80% 0%, #f8efe6 0%, rgba(248,239,230,0) 60%), linear-gradient(180deg, #f3e7db 0%, #ecdccc 100%);
        background-attachment: fixed; padding: 40px 16px 60px; overflow-x: hidden;
      }
      /* ombres de feuillage floues, comme dans les vidéos */
      .leaf { position: fixed; z-index: 0; border-radius: 40% 60% 55% 45%; background: rgba(70,85,55,.16); filter: blur(70px); pointer-events: none; }
      .leaf.a { right: -120px; top: -80px; width: 420px; height: 520px; }
      .leaf.b { left: -160px; bottom: -120px; width: 520px; height: 420px; }
      .page {
        position: relative; z-index: 1; max-width: 680px; margin: 0 auto; background: #fffdfb; border: 1px solid var(--line); border-radius: 30px;
        box-shadow: 0 30px 70px rgba(110,80,50,.16), 0 6px 18px rgba(110,80,50,.08); padding: 44px 40px 40px;
      }
      .who { display: flex; align-items: center; gap: 14px; margin-bottom: 34px; }
      .who img { width: 56px; height: 56px; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 6px 16px rgba(110,80,50,.22); object-fit: cover; }
      .who b { display: block; font-size: 17px; }
      .who span { font-size: 14px; color: var(--muted); }
      .kicker { font-size: 14px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--teal); }
      h1 { margin-top: 12px; font-size: clamp(34px, 7vw, 52px); font-weight: 800; letter-spacing: -.035em; line-height: 1.04; }
      h1 em { font-style: normal; color: var(--teal); }
      .lead { margin-top: 18px; font-size: 18px; line-height: 1.5; color: var(--sec); max-width: 52ch; }
      .cards { display: grid; gap: 14px; margin-top: 16px; }
      h2 { margin-top: 38px; font-size: 24px; font-weight: 800; letter-spacing: -.02em; }
      .who-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 16px; }
      .pq { padding: 18px; border-radius: 20px; background: var(--teal-bg); border: 2px solid rgba(44,106,110,.18); }
      .pq b { display: block; font-size: 16px; color: var(--teal); line-height: 1.3; }
      .pq p { margin-top: 6px; font-size: 14px; line-height: 1.45; color: var(--sec); }
      .plus { margin-top: 14px; font-size: 15px; font-weight: 600; color: var(--sec); }
      @media (max-width: 620px) { .who-grid { grid-template-columns: 1fr; } }
      .card { display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; background: #fff; border-radius: 20px; box-shadow: 0 10px 28px rgba(110,80,50,.10), 0 1px 3px rgba(110,80,50,.08); }
      .card .ic { flex: none; width: 46px; height: 46px; border-radius: 14px; background: var(--teal-bg); display: flex; align-items: center; justify-content: center; }
      .card b { display: block; font-size: 17px; }
      .card p { margin-top: 3px; font-size: 15px; color: var(--muted); line-height: 1.45; }
      form { margin-top: 32px; }
      label { display: block; font-size: 15px; font-weight: 700; margin-bottom: 10px; }
      .row { display: flex; gap: 12px; flex-wrap: wrap; }
      input[type="email"] {
        flex: 1 1 260px; min-width: 0; height: 60px; padding: 0 22px; border-radius: 30px; border: 2px solid var(--line); background: #f8f4ef;
        font: 600 17px "Inter", sans-serif; color: var(--ink); outline: none;
      }
      input[type="email"]:focus { border-color: var(--teal); background: #fff; }
      button {
        flex: 0 0 auto; height: 60px; padding: 0 28px 4px; border-radius: 20px; border: 4px solid #1c1b1a; background: var(--orange); color: #1c1b1a;
        font: 600 20px "Outfit", "Inter", sans-serif; cursor: pointer; box-shadow: 0 6px 0 #1c1b1a; transition: transform .08s, box-shadow .08s;
      }
      button:hover { transform: translateY(-1px); }
      button:active { transform: translateY(5px); box-shadow: 0 1px 0 #1c1b1a; }
      button[disabled] { opacity: .6; cursor: default; }
      .consent { margin-top: 14px; font-size: 13px; line-height: 1.5; color: var(--muted); }
      .consent a { color: var(--muted); }
      .msg { display: none; margin-top: 18px; padding: 16px 18px; border-radius: 16px; font-size: 16px; font-weight: 600; line-height: 1.45; }
      .msg.ok { display: block; background: var(--teal-bg); color: var(--teal); }
      .msg.err { display: block; background: #fbe5df; color: var(--red); }
      .foot { position: relative; z-index: 1; max-width: 680px; margin: 22px auto 0; text-align: center; font-size: 13px; color: var(--muted); }
      .foot a { color: var(--muted); }
      @media (max-width: 520px) { .page { padding: 32px 22px 28px; } button { width: 100%; } }
    </style>
  </head>
  <body>
    <i class="leaf a"></i><i class="leaf b"></i>
    <main class="page">
      <div class="who">
        <img src="/liste-avatar.jpg" alt="Florian Dupuis" width="56" height="56" />
        <div><b>Florian · @dupflodev</b><span>Je teste l’IA pour de vrai, tous les jours</span></div>
      </div>

      <p class="kicker">Formation · liste d’attente</p>
      <h1>Ton site professionnel, construit <em>avec l’IA</em>.</h1>
      <p class="lead">
        Je prépare ma formation. Elle n’est pas encore ouverte : inscris-toi pour être prévenu en premier et avoir accès au meilleur prix dès le lancement.
      </p>

      <h2>Pour qui ?</h2>
      <div class="who-grid">
        <div class="pq"><b>Tu débutes avec l’IA</b><p>Tu veux apprendre à travailler avec Claude ou ChatGPT sur un vrai projet, pas sur des exemples.</p></div>
        <div class="pq"><b>Tu veux ton propre site pro</b><p>Artisan, indépendant, association : un site WordPress en ligne, que tu sais modifier toi-même.</p></div>
        <div class="pq"><b>Tu veux vendre des sites</b><p>Freelance ou développeur : une méthode pour livrer plus vite à tes clients, avec l’IA.</p></div>
      </div>
      <p class="plus">Et dans tous les cas : la méthode pour mener tes autres projets avec l’IA.</p>

      <h2>Pourquoi t’inscrire</h2>
      <div class="cards">
        <div class="card">
          <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2C6A6E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg></div>
          <div><b>Le meilleur prix dès le lancement</b><p>Un accès au meilleur prix, réservé aux inscrits de la liste, dès l’ouverture.</p></div>
        </div>
        <div class="card">
          <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2C6A6E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
          <div><b>Prévenu en premier</b><p>Un email le jour de l’ouverture, avant l’annonce publique.</p></div>
        </div>
        <div class="card">
          <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2C6A6E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div>
          <div><b>Ton avis compte</b><p>La liste m’aide à construire la formation autour de ce dont tu as vraiment besoin.</p></div>
        </div>
        <div class="card">
          <div class="ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2C6A6E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg></div>
          <div><b>Zéro spam</b><p>Seulement les emails liés à la formation. Désinscription en un clic.</p></div>
        </div>
      </div>

      <form id="wl" novalidate>
        <label for="wl-email">Ton email</label>
        <div class="row">
          <input id="wl-email" name="email" type="email" autocomplete="email" placeholder="toi@exemple.fr" required />
          <button type="submit">Je rejoins la liste</button>
        </div>
        <p class="consent">
          En t’inscrivant, tu acceptes de recevoir les emails liés à la formation. Tes données restent chez Brevo (France), ne sont jamais revendues, et tu peux te désinscrire à tout moment.{" "}
          <a href="/fr/confidentialite/">Confidentialité</a>
        </p>
        <p id="wl-msg" class="msg" role="status" aria-live="polite"></p>
      </form>
    </main>
    <p class="foot"><a href="/fr/">dupflo.dev</a> · <a href="/fr/mentions-legales/">Mentions légales</a></p>

    <script>
      const form = document.getElementById('wl') as HTMLFormElement;
      const input = document.getElementById('wl-email') as HTMLInputElement;
      const msg = document.getElementById('wl-msg') as HTMLParagraphElement;
      const btn = form.querySelector('button') as HTMLButtonElement;
      const show = (cls: 'ok' | 'err', text: string) => { msg.className = `msg ${cls}`; msg.textContent = text; };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = input.value.trim();
        if (!/^[^@\s]+@[^@\s.]+\.[^@\s]+$/.test(email)) return show('err', 'Cet email ne semble pas valide.');
        btn.disabled = true;
        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, source: 'liste-attente-101' }),
          });
          if (res.ok) {
            form.querySelector('.row')?.remove();
            show('ok', 'C’est noté, tu es sur la liste. Je te préviens dès l’ouverture.');
          } else {
            show('err', 'L’inscription n’a pas marché. Réessaie dans un instant.');
            btn.disabled = false;
          }
        } catch {
          show('err', 'Pas de connexion. Réessaie dans un instant.');
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>
