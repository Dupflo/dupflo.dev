---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { STATUS_GLYPH } from '../../../lib/entry';
import { t, localePath, otherLang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const lang = 'fr' as const;
const ui = t(lang);
const { project } = Astro.props;
const { title, tagline, description, status, stack, url, repo } = project.data;
const { Content } = await render(project);

const links = [
  url ? { href: url, label: new URL(url).host.replace(/^www\./, '') } : null,
  repo ? { href: repo, label: 'GitHub' } : null,
].filter((l) => l !== null);
---

<Base lang={lang} title={title} description={tagline[lang]} translationHref={localePath(otherLang(lang), `/projects/${project.id}`)}>
  <article>
    <header class="border-b py-8">
      <div
        class:list={[
          'text-[13px]',
          status === 'live' ? 'text-accent' : 'text-dim',
        ]}
      >
        <span aria-hidden="true">{STATUS_GLYPH[status]}</span>
        <span>{ui.status[status]}</span>
      </div>

      <h1 class="font-display mt-2 text-5xl leading-none tracking-tight">
        {title}
      </h1>
      <p class="font-text mt-3 max-w-[62ch] text-[19px] leading-[1.5] text-dim">
        {tagline[lang]}
      </p>

      <div class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[12px] uppercase tracking-[0.1em] text-dim">
        {
          links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener" class="hover:text-accent">
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>

      <p class="mt-4 text-[13px] text-dim">{stack.join(' · ')}</p>
    </header>

    <div class="prose py-10">
      <p>{description[lang]}</p>
      <Content />
    </div>

    <footer class="border-t pt-4 text-[13px] text-dim">
      <a href={localePath(lang, '/projects')} class="uppercase tracking-[0.1em] hover:text-accent">
        <span aria-hidden="true">←</span> {ui.nav.projects}
      </a>
    </footer>
  </article>
</Base>
