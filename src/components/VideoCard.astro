---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { iso, compact } from '../lib/entry';

interface Props {
  video: CollectionEntry<'videos'>;
}

const { video } = Astro.props;
const { title, platform, url, date, thumbnail, views, likes } = video.data;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="group block text-[12px]"
  aria-label={`${title} — on ${platform}`}
>
  <div
    class="relative aspect-[9/16] overflow-hidden border bg-raised group-hover:border-accent"
  >
    {
      thumbnail ? (
        <Image
          src={thumbnail}
          alt=""
          widths={[180, 360]}
          sizes="(min-width: 768px) 180px, 40vw"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      ) : (
        /* No still committed yet: a typographic tile rather than a grey box. */
        <div class="flex h-full flex-col justify-between p-2 text-dim">
          <span class="uppercase tracking-[0.1em]">{platform}</span>
          <span class="text-[22px] leading-none text-rule" aria-hidden="true">
            ▶
          </span>
          <span class="tabular-nums">{iso(date)}</span>
        </div>
      )
    }
    <!-- Reach and reception, in place of a platform label that said nothing. -->
    <span
      class="absolute inset-x-0 bottom-0 flex gap-3 bg-bg/85 px-2 py-1 tabular-nums text-dim"
    >
      {
        views !== undefined && (
          <span>
            <svg
              class="inline size-[1.05em] align-[-0.15em] text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>{' '}
            {compact(views)}
          </span>
        )
      }
      {
        likes !== undefined && (
          <span>
            <svg
              class="inline size-[1.05em] align-[-0.15em] text-accent"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 21S3 14.6 3 8.9A5 5 0 0 1 12 6a5 5 0 0 1 9 2.9C21 14.6 12 21 12 21Z" />
            </svg>{' '}
            {compact(likes)}
          </span>
        )
      }
      {views === undefined && likes === undefined && <span>{platform}</span>}
    </span>
  </div>

  <h3 class="mt-2 line-clamp-2 leading-snug group-hover:text-accent">
    {title}
  </h3>
</a>
