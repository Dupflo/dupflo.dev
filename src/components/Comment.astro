---
/**
 * A comment quoted from a video's comment section, with my reply when there
 * was one.
 *
 * Transcribed rather than screenshotted: the people who wrote these were
 * commenting a video, not publishing on this site. Their words carry the
 * argument, their profile pictures do not.
 */
import { t, DEFAULT_LANG, type Lang } from '../i18n/ui';

interface Props {
  /** As displayed on the platform, pseudonym included. */
  author: string;
  platform: 'Instagram' | 'YouTube';
  /** Omitted when the count is not worth reporting. */
  likes?: number;
}

const { author, platform, likes } = Astro.props;
const hasReply = Astro.slots.has('reply');
// The component is dropped into articles in both languages, so the one string
// it owns follows the page rather than the file it was written in.
const ui = t((Astro.currentLocale as Lang) ?? DEFAULT_LANG);
---

<figure class="my-7 border bg-raised p-5 text-[15px] leading-relaxed">
  <div class="flex flex-wrap items-baseline gap-x-2 text-[13px]">
    <span class="text-ink">{author}</span>
    <span class="text-dim">{platform}</span>
    {
      likes !== undefined && (
        <span class="text-dim tabular-nums">
          <svg
            class="inline size-[1.05em] align-[-0.15em] text-accent"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 21S3 14.6 3 8.9A5 5 0 0 1 12 6a5 5 0 0 1 9 2.9C21 14.6 12 21 12 21Z" />
          </svg>{' '}
          {likes}
        </span>
      )
    }
  </div>

  <blockquote class="mt-3 text-ink"><slot /></blockquote>

  {
    hasReply && (
      <div class="mt-4 border-l-2 border-rule pl-4">
        <div class="text-[13px] text-dim">{ui.commentReply}</div>
        <blockquote class="mt-1 text-ink">
          <slot name="reply" />
        </blockquote>
      </div>
    )
  }
</figure>
