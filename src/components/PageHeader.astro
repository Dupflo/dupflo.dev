---
interface Props {
  title: string;
  intro?: string;
  count?: number;
}

const { title, intro, count } = Astro.props;
---

<header class="flex items-baseline gap-3 border-b py-8">
  <div class="flex-1">
    <h1 class="font-display text-5xl leading-none tracking-tight">{title}</h1>
    {intro && <p class="font-text mt-3 text-[17px] text-dim">{intro}</p>}
  </div>
  {
    count !== undefined && (
      <span class="text-[13px] tabular-nums text-dim">{count}</span>
    )
  }
</header>
