---
/**
 * A quoted post from X, rendered as static markup.
 *
 * The official embed ships `platform.x.com/widgets.js`, which is third-party
 * JavaScript on a site that has none, renders an iframe styled by X rather
 * than by us, and shows nothing at all to readers who block it — the same
 * reason video listings link out instead of embedding a player.
 *
 * The quote is therefore transcribed here. `url` keeps the attribution
 * verifiable: the reader is one click from the source.
 */
interface Props {
  /** Permalink to the post. */
  url: string;
  author: string;
  /** Without the leading @. */
  handle: string;
  /** Displayed as written — no locale reformatting of a cited date. */
  date: string;
}

const { url, author, handle, date } = Astro.props;
---

<figure class="my-7 border bg-raised p-5 text-[15px] leading-relaxed">
  <div class="flex items-baseline gap-2 text-[13px]">
    <svg
      class="size-[1em] shrink-0 self-center text-dim"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93ZM17.6 20.64h2.04L6.48 3.24H4.3Z"
      />
    </svg>
    <span class="text-ink">{author}</span>
    <span class="text-dim">@{handle}</span>
  </div>

  <blockquote class="mt-3 text-ink">
    <slot />
  </blockquote>

  <figcaption class="mt-3 text-[13px] text-dim">
    <a href={url} target="_blank" rel="noopener" class="hover:text-accent">
      {date}<span aria-hidden="true"> ↗</span>
    </a>
  </figcaption>
</figure>
